# Segredos locais. O exemplo permanece versionado.
.env
.env.*
!.env.example

# Ambientes virtuais e caches Python.
.venv/
.venv-*/
venv/
env/
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Estado privado gerado pelo agente.
/memory/memory.json
/memory/memory.corrupt-*.json
codex-session-*.md

# Perfis do navegador e build do Native Messaging host.
/agent-browser-profile-*/
/.browser-host-dist/

# Artefatos de build e distribuição na raiz.
/build/
/dist/
*.egg-info/

# Configuração local de editores.
.vscode/
.idea/

# Logs, arquivos temporários e metadados do sistema.
*.log
*.tmp
*.temp
*.bak
Thumbs.db
Desktop.ini
.DS_Store
