# Chaves de API — preencha somente os provedores que pretende usar.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
FISH_API_KEY=
HF_TOKEN=

# Provedores e modelos de chat.
GROQ_MODEL=openai/gpt-oss-20b
MISTRAL_MODEL=open-mistral-nemo
OPENROUTER_MODEL=z-ai/glm-5.2:free
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731
OLLAMA_MODEL=llama3:latest
OLLAMA_BASE_URL=http://localhost:11434/v1

# Listas opcionais para os menus de modelos (separadas por vírgulas).
GROQ_MODELS=
MISTRAL_MODELS=
OPENROUTER_MODELS=
NVIDIA_MODELS=

# STT (transcrição de voz): local, groq ou fish.
STT_PROVIDER=local
GROQ_STT_MODEL=whisper-large-v3
WHISPER_MODEL=medium

# TTS (síntese de voz): edge, fish ou gemini.
TTS_PROVIDER=edge
FISH_MODEL=s2.1-pro-free
FISH_VOICE_ID=
FISH_REFERENCE_ID=
FISH_VOICES=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Interrupção e sensibilidade do áudio.
TTS_INTERRUPT_ENABLED=false
TTS_INTERRUPT_DELAY=0.7
TTS_INTERRUPT_THRESHOLD=0.08
MIC_SILENCE_DURATION=1.15
MIC_PRE_ROLL=0.55

# Leitura de arquivos.
READ_FILE_MAX_CHARS=6000

BROWSER_USER_DATA_DIR=~/.agente_pessoal/browser
BROWSER_HEADLESS=false
BROWSER_MAX_TEXT_CHARS=12000

# Geração de imagens via Hugging Face.
HF_API_KEY=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_PROVIDER=auto
