# Copie este arquivo para .env e preencha as chaves localmente.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=z-ai/glm-5.2:free
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

# Opcional: altere os menus separando os modelos por virgulas.
# GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,groq/compound,groq/compound-mini
# OPENROUTER_MODELS=z-ai/glm-5.2:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free,openrouter/free
# NVIDIA_MODELS=deepseek-ai/deepseek-v4-flash-0731,nvidia/nemotron-3.5-lightning-30b-a3b,deepseek-ai/deepseek-v4-flash,deepseek-ai/deepseek-v4-pro,nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-nano-30b-a3b,z-ai/glm-5.2,minimax-m3,moonshotai/kimi-k2.6,nvidia/muse-glimmer-30b,nvidia/inkling,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Volume minimo para interromper o TTS falando.
TTS_INTERRUPT_THRESHOLD=0.08

# STT e TTS tambem sao escolhidos no menu ao iniciar.
# STT_PROVIDER=local | groq | fish
# TTS_PROVIDER=edge | fish | gemini
# GROQ_STT_MODEL=whisper-large-v3
# WHISPER_MODEL=medium
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore
# MIC_SILENCE_DURATION=1.15
# READ_FILE_MAX_CHARS=6000