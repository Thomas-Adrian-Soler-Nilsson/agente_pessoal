# Chaves de API — preencha somente os provedores que pretende usar.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.1-pro-preview,gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
TOKENHARBOR_API_KEY=
NVIDIA_API_KEY=
FISH_API_KEY=
HF_TOKEN=
HF_API_KEY=

# Provedores e modelos de chat.
GROQ_MODEL=openai/gpt-oss-20b
MISTRAL_MODEL=open-mistral-nemo
OPENROUTER_MODEL=z-ai/glm-5.2:free
TOKENHARBOR_MODEL=deepseek-v4.1-flash:free
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731
OLLAMA_MODEL=llama3:latest
OLLAMA_BASE_URL=http://localhost:11434/v1
HF_MODEL=openai/gpt-oss-20b
HF_PROVIDER=auto

# Listas opcionais para os menus de modelos (separadas por vírgulas).
GROQ_MODELS=
MISTRAL_MODELS=
OPENROUTER_MODELS=
TOKENHARBOR_MODELS=deepseek-v4.1-flash:free,deepseek-v4-flash:free,mimo-v2.5:free
NVIDIA_MODELS=
HF_MODELS=

# Hugging Face — capacidades generativas.
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_PROVIDER=auto
HF_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
HF_TTS_PROVIDER=auto
HF_3D_MODEL=tencent/Hunyuan3D-2
HF_3D_SPACE=tencent/Hunyuan3D-2
HF_3D_API_NAME=/generation_all

# Geração 3D hospedada (sem clone/instalação local).
RODIN_API_KEY=
RODIN_TIER=Gen-2.5-Medium
RODIN_QUALITY=medium
RODIN_TIMEOUT=1200
TRIFY3D_API_KEY=
TRIFY3D_MODE=quality
TRIFY3D_STYLE=realistic
TRIFY3D_TIMEOUT=1200
THREE_WS_URL=https://three.ws
THREE_WS_TIMEOUT=600
NVIDIA_TRELLIS_API_KEY=
NVIDIA_TRELLIS_URL=https://ai.api.nvidia.com/v1/genai/microsoft/trellis
NVIDIA_TRELLIS_TIMEOUT=900
NVIDIA_TRELLIS_SEED=0
NVIDIA_TRELLIS_SS_STEPS=25
NVIDIA_TRELLIS_SLAT_STEPS=25
NVIDIA_TRELLIS_NO_TEXTURE=false

# TripoSR local (opcional; clone o reposit\u00f3rio oficial separadamente).
TRIPOSR_PATH=
TRIPOSR_PYTHON=
TRIPOSR_DEVICE=cuda:0
TRIPOSR_TIMEOUT=900
TRIPOSR_BAKE_TEXTURE=false

# STT (transcrição de voz): local, groq ou fish.
STT_PROVIDER=local
GROQ_STT_MODEL=whisper-large-v3
WHISPER_MODEL=medium

# TTS (síntese de voz): edge, fish ou gemini.
TTS_PROVIDER=edge
FISH_MODEL=s2.1-pro-free
FISH_VOICE_ID=
FISH_REFERENCE_ID=
FISH_VOICES=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Interrupção e sensibilidade do áudio.
TTS_INTERRUPT_ENABLED=false
TTS_INTERRUPT_DELAY=0.7
TTS_INTERRUPT_THRESHOLD=0.08
MIC_SILENCE_DURATION=1.15
MIC_PRE_ROLL=0.55

# Leitura de arquivos.
READ_FILE_MAX_CHARS=6000

BROWSER_USER_DATA_DIR=~/.agente_pessoal/browser
BROWSER_HEADLESS=false
BROWSER_MAX_TEXT_CHARS=12000
