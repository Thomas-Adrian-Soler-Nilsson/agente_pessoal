{
  "manifest_version": 3,
  "name": "Agente Pessoal Browser Bridge",
  "version": "1.0.0",
  "description": "Controla abas selecionadas do Chrome pelo Agente Pessoal local.",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "nativeMessaging",
    "downloads",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Agente Pessoal",
    "default_popup": "popup.html"
  }
}